# DEPTHS — Ghostty theme (AES-001)
# Abyss terminal surface for the Cashie Relay / DEPTHS CLI lane.
# Spec: ~/PROJECTS/00-active/depths/docs/DEPTHS-aesthetic-spec.md
# Tokens: abyss · trench · silt · foam · depth · pressure · breach · mute
# No purple. No neon. Atmosphere = vertical density + pressure, not sparkle.
#
# Apply: theme = depths  (already set in ~/.config/ghostty/config)
# Reload: Super+Shift+,  or restart Ghostty

background = #0A0C0B
foreground = #C8D2CA
cursor-color = #5FAF8A
cursor-text = #0A0C0B
selection-background = #2A332E
selection-foreground = #C8D2CA

# ANSI 0–7  (normal)
